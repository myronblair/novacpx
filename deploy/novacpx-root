function ncr_main(array $argv): int {
    if (PHP_SAPI !== 'cli') return 1;
    if (posix_geteuid() !== 0) { fwrite(STDERR, "novacpx-root: must run as root (through sudo)\n"); return 64; }
    // Only root itself or the web user (through sudo) may use this.
    $sudoUid = getenv('SUDO_UID');
    if ($sudoUid !== false && $sudoUid !== '0') {
        $www = posix_getpwnam('www-data');
        if (!$www || (int)$sudoUid !== $www['uid']) { fwrite(STDERR, "novacpx-root: caller not permitted\n"); return 64; }
    }
    umask(022);
    $cmd = $argv[1] ?? '';
    if (!isset(NCR_COMMANDS[$cmd]) || count($argv) !== 2) { fwrite(STDERR, "novacpx-root: unknown command\n"); return 64; }
    $raw = stream_get_contents(STDIN, 4194305);
    if ($raw !== false && strlen($raw) > 4194304) { fwrite(STDERR, "novacpx-root: request too large\n"); return 64; }
    $params = $raw === '' || $raw === false ? [] : json_decode($raw, true);
    if (!is_array($params)) { fwrite(STDERR, "novacpx-root: parameters must be a JSON object\n"); return 64; }
    try {
        $rc = (NCR_COMMANDS[$cmd])($params);
        return $rc;
    } catch (NcrRefused $e) {
        fwrite(STDERR, 'novacpx-root: refused: ' . $e->getMessage() . "\n");
        return 64;
    } catch (Throwable $e) {
        fwrite(STDERR, 'novacpx-root: error: ' . get_class($e) . ': ' . $e->getMessage() . "\n");
        return 70;
    }
}

if (!defined('NOVACPX_ROOT_LIB')) exit(ncr_main($argv));
