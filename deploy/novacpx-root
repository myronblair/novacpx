const NCR_SRC_DIR = '/opt/novacpx-src';

function ncr_webroot(): string {
    $ini = @parse_ini_file('/etc/novacpx/config.ini', true) ?: [];
    $w = $ini['panel']['webroot'] ?? '/srv/novacpx/public';
    return is_string($w) && preg_match('#^/[A-Za-z0-9_./-]{1,100}$#', $w) ? rtrim($w, '/') : '/srv/novacpx/public';
}

function ncr_channel_branch(mixed $c): string { return $c === 'beta' ? 'beta' : 'main'; }

function ncr_git(array $args): array { return ncr_run(array_merge(['git', '-C', NCR_SRC_DIR], $args)); }

/** Fetch the source checkout's origin and report what an update would bring. */
function cmd_panel_update_check(array $p): int {
    if (!is_dir(NCR_SRC_DIR . '/.git')) refuse('source checkout not found');
    $branch = ncr_channel_branch($p['channel'] ?? 'stable');
    ncr_run(['git', '-C', NCR_SRC_DIR, 'fetch', '-q', 'origin'], null, false, [], null);
    [, $log] = ncr_git(['log', "HEAD..origin/{$branch}", '--oneline']);
    [, $cur] = ncr_git(['rev-parse', '--short', 'HEAD']);
    [, $cb]  = ncr_git(['branch', '--show-current']);
    [, $rv]  = ncr_git(['show', "origin/{$branch}:VERSION"]);
    return ncr_json(['updates' => array_values(array_filter(explode("\n", trim($log)))), 'current_commit' => trim($cur),
                     'branch' => trim($cb) ?: 'main', 'remote_version' => trim($rv)]);
}

/** Hand the checkout to the deploy runner (pull, syntax check with rollback, rsync, migrations, version record). */
function cmd_panel_update_apply(array $p): int {
    if (!is_dir(NCR_SRC_DIR . '/.git')) refuse('source checkout not found');
    $branch = ncr_channel_branch($p['channel'] ?? 'stable');
    [, $before] = ncr_git(['rev-parse', 'HEAD']);
    file_put_contents('/tmp/novacpx-deploy-queue.txt', NCR_SRC_DIR . '|' . ncr_webroot() . '|manual|' . $branch . "\n", FILE_APPEND | LOCK_EX);
    [$rc, $out] = ncr_run(['bash', NCR_SRC_DIR . '/deploy/deploy-runner.sh']);
    [, $after] = ncr_git(['rev-parse', 'HEAD']);
    $ver = trim((string)@file_get_contents(NCR_SRC_DIR . '/VERSION'));
    $log = is_file('/var/log/novacpx/deploy.log') ? implode('', array_slice(file('/var/log/novacpx/deploy.log'), -12)) : '';
    return ncr_json(['before' => trim($before), 'after' => trim($after), 'updated' => trim($before) !== trim($after), 'version' => $ver, 'branch' => $branch, 'log' => $log . $out]);
}

// ───────────────────────── database engines and admin tools ─────────────────────────

function ncr_emit(string $line): void { echo $line; flush(); }

function cmd_dbengine(array $p): int {
    $engine = $p['engine'] ?? '';
    $action = $p['action'] ?? '';
    $pk = ['mysql' => ['mysql-server'], 'mariadb' => ['mariadb-server'], 'postgresql' => ['postgresql', 'postgresql-contrib']];
    $rm = ['mysql' => ['mysql-server', 'mysql-client'], 'mariadb' => ['mariadb-server', 'mariadb-client'], 'postgresql' => ['postgresql', 'postgresql-contrib']];
    if (!isset($pk[$engine])) refuse('invalid engine');
    if (!in_array($action, ['install', 'remove', 'start', 'stop', 'restart'], true)) refuse('invalid action');
    $env = ['DEBIAN_FRONTEND' => 'noninteractive'];
    if ($action === 'install') {
        $r = ncr_run(array_merge(['apt-get', 'install', '-y'], $pk[$engine]), null, true, $env);
        ncr_run(['systemctl', 'enable', $engine]); ncr_run(['systemctl', 'start', $engine]);
        return (int)$r[0];
    }
    if ($action === 'remove') {
        ncr_run(['systemctl', 'stop', $engine]);
        return (int)ncr_run(array_merge(['apt-get', 'remove', '-y'], $rm[$engine]), null, true, $env)[0];
    }
    return ncr_out(ncr_run(['systemctl', $action, $engine]), false);
}

/** phpMyAdmin / pgAdmin 4 / Adminer: install, reinstall, remove. Streams progress lines. */
function cmd_db_tool(array $p): int {
    $tool = $p['tool'] ?? '';
    $action = $p['action'] ?? '';
    if (!in_array($tool, ['phpmyadmin', 'pgadmin', 'adminer'], true)) refuse('invalid tool');
    if (!in_array($action, ['install', 'reinstall', 'remove'], true)) refuse('invalid action');
    $env = ['DEBIAN_FRONTEND' => 'noninteractive'];
    $ini = @parse_ini_file('/etc/novacpx/config.ini', true) ?: [];
    $php = $ini['web']['php_default'] ?? '8.3';
    if (!preg_match('/^[0-9]\.[0-9]$/', (string)$php)) $php = '8.3';
    $apt = fn(array $a) => (int)ncr_run(array_merge(['apt-get'], $a), null, true, $env)[0];

    if ($tool === 'adminer') {
        $path = ncr_webroot() . '/adminer.php';
        if ($action === 'remove') { ncr_emit("▶ Removing Adminer…\n"); @unlink($path); ncr_emit("  ✓ Removed\n"); return 0; }
        ncr_emit("▶ Downloading Adminer…\n");
        $tmp = '/root/.ncr-adminer.php';
        [$rc, $out] = ncr_run(['curl', '-fsSL', 'https://www.adminer.org/latest.php', '-o', $tmp]);
        if ($rc !== 0 || !is_file($tmp) || filesize($tmp) < 100000) { @unlink($tmp); ncr_emit("  ✗ Download failed: {$out}\n"); return 1; }
        if (is_link($path)) refuse('destination is a symlink');
        rename($tmp, $path); chown($path, 'www-data'); chgrp($path, 'www-data'); chmod($path, 0644);
        ncr_emit("  ✓ Adminer installed at /adminer.php (" . round(filesize($path) / 1024) . " KB)\n");
        return 0;
    }

    if ($tool === 'phpmyadmin') {
        if ($action === 'remove' || $action === 'reinstall') {
            ncr_emit("▶ Removing phpMyAdmin…\n");
            // the package's post-removal script runs `a2disconf phpmyadmin`, which fails when the conf was never registered
            if (is_dir('/etc/apache2/conf-available') && !file_exists('/etc/apache2/conf-available/phpmyadmin.conf') && is_file('/etc/phpmyadmin/apache.conf')) {
                symlink('/etc/phpmyadmin/apache.conf', '/etc/apache2/conf-available/phpmyadmin.conf');
            }
            $apt(['remove', '-y', 'phpmyadmin']);
            @unlink('/etc/nginx/conf.d/phpmyadmin.conf'); @unlink('/etc/nginx/snippets/phpmyadmin.conf');
            if ($action === 'remove') return 0;
        }
        ncr_emit("▶ Pre-configuring debconf answers…\n");
        ncr_run(['debconf-set-selections'], "phpmyadmin phpmyadmin/reconfigure-webserver multiselect apache2\nphpmyadmin phpmyadmin/dbconfig-install boolean true\n");
        ncr_emit("▶ Installing phpMyAdmin (this takes 20–60 seconds)…\n");
        if ($apt(['install', '-y', 'phpmyadmin', "php{$php}-mbstring", "php{$php}-xml", "php{$php}-zip"]) !== 0) { ncr_emit("✗ apt-get failed\n"); return 1; }
        ncr_emit("▶ Configuring web server alias…\n");
        if (is_dir('/etc/apache2/conf-available') && is_file('/etc/phpmyadmin/apache.conf')) {
            if (!file_exists('/etc/apache2/conf-available/phpmyadmin.conf')) symlink('/etc/phpmyadmin/apache.conf', '/etc/apache2/conf-available/phpmyadmin.conf');
            ncr_run(['a2enconf', 'phpmyadmin']);   // registered properly, so the package can remove it again
            ncr_run(['systemctl', 'reload', 'apache2']);
            ncr_emit("  ✓ Apache alias enabled\n");
        }
        if (is_dir('/etc/nginx')) {
            // A `location` block is only valid inside a server block, so it is offered as a snippet (never dropped into conf.d,
            // where it would make `nginx -t` fail and block every later reload).
            @mkdir('/etc/nginx/snippets', 0755, true);
            ncr_write_file('/etc/nginx/snippets/phpmyadmin.conf', "location /phpmyadmin {\n    root /usr/share/;\n    index index.php;\n    location ~ ^/phpmyadmin/(.+\\.php)\$ {\n        root /usr/share/;\n        fastcgi_pass unix:/run/php/php{$php}-fpm.sock;\n        fastcgi_index index.php;\n        include fastcgi.conf;\n    }\n}\n");
            ncr_emit("  ✓ nginx snippet written: add `include snippets/phpmyadmin.conf;` inside the server block that should serve /phpmyadmin\n");
        }
        return 0;
    }

    // pgAdmin 4
    if ($action === 'remove' || $action === 'reinstall') { ncr_emit("▶ Removing pgAdmin 4…\n"); $apt(['remove', '-y', 'pgadmin4', 'pgadmin4-web']); if ($action === 'remove') return 0; }
    if (!is_file('/etc/apt/sources.list.d/pgadmin4.list')) {
        ncr_emit("▶ Adding pgAdmin apt repository…\n");
        [, $codename] = ncr_run(['lsb_release', '-cs']);
        $codename = trim($codename);
        if (!preg_match('/^[a-z]{3,20}$/', $codename)) $codename = 'jammy';
        [$rc, $key] = ncr_run(['curl', '-fsSL', 'https://www.pgadmin.org/static/packages_pgadmin_org.pub']);
        if ($rc !== 0) { ncr_emit("  ✗ could not fetch the repository key\n"); return 1; }
        [$rc, $out] = ncr_run(['gpg', '--batch', '--yes', '--dearmor', '-o', '/usr/share/keyrings/pgadmin4.gpg'], $key);
        if ($rc !== 0) { ncr_emit("  ✗ gpg failed: {$out}\n"); return 1; }
        ncr_write_file('/etc/apt/sources.list.d/pgadmin4.list', "deb [signed-by=/usr/share/keyrings/pgadmin4.gpg] https://ftp.postgresql.org/pub/pgadmin/pgadmin4/apt/{$codename} pgadmin4 main\n");
        ncr_emit("▶ Updating package lists…\n");
        $apt(['update']);
    }
    ncr_emit("▶ Installing pgAdmin 4 web (this takes 1–3 minutes)…\n");
    if ($apt(['install', '-y', 'pgadmin4-web']) !== 0) { ncr_emit("✗ apt-get failed\n"); return 1; }
    ncr_emit("▶ Enabling Apache configuration…\n");
    ncr_run(['a2enconf', 'pgadmin4']); ncr_run(['systemctl', 'reload', 'apache2']);
    $email = $p['email'] ?? ''; $pass = $p['password'] ?? '';
    if ($email !== '' && $pass !== '') {
        if (!is_string($email) || !filter_var($email, FILTER_VALIDATE_EMAIL) || strlen($email) > 120) refuse('invalid pgAdmin email');
        if (!is_string($pass) || strlen($pass) < 8 || strlen($pass) > 128 || preg_match('/[\r\n\0]/', $pass)) refuse('invalid pgAdmin password');
        ncr_emit("▶ Initialising pgAdmin database and admin user…\n");
        @unlink('/var/lib/pgadmin/pgadmin4.db');
        foreach (glob('/var/lib/pgadmin/pgadmin4.db.*') ?: [] as $f) @unlink($f);
        ncr_run(['/usr/pgadmin4/venv/bin/python3', '/usr/pgadmin4/web/setup.py', 'setup-db'], null, true, ['PGADMIN_SETUP_EMAIL' => $email, 'PGADMIN_SETUP_PASSWORD' => $pass]);
        @mkdir('/var/log/pgadmin', 0755, true);
        ncr_run(['chown', '-R', '-h', 'www-data:www-data', '/var/lib/pgadmin', '/var/log/pgadmin']);
        ncr_run(['systemctl', 'reload', 'apache2']);
    } else {
        ncr_emit("  ⚠ No credentials provided — run Reinstall to set up the admin user\n");
    }
    return 0;
}

// ───────────────────────── proxy local mode ─────────────────────────

/** Local reverse-proxy mode: nginx takes 80/443, Apache moves to an internal port (and back). Streams progress lines. */
function cmd_proxy_local(array $p): int {
    $action = $p['action'] ?? '';
    if (!in_array($action, ['enable', 'disable'], true)) refuse('invalid action');
    $env = ['DEBIAN_FRONTEND' => 'noninteractive'];
    if ($action === 'disable') {
        $port = v_int($p['apache_port'] ?? 8090, 1, 65535, 'port');
        ncr_emit("» Stopping nginx...\n");
        ncr_run(['systemctl', 'stop', 'nginx']); ncr_run(['systemctl', 'disable', 'nginx']);
        ncr_emit("» Migrating Apache from port {$port} → 80...\n");
        ob_start(); cmd_web_apache_port(['from' => $port, 'to' => 80]); $res = trim((string)ob_get_clean());
        ncr_emit("  {$res}\n");
        ncr_emit("» Restarting Apache on port 80...\n");
        ncr_run(['systemctl', 'restart', 'apache2']);
        ncr_emit("✓ Proxy disabled. Apache is back on port 80/443.\n");
        return 0;
    }
    $port = v_int($p['apache_port'] ?? 8090, 1024, 65535, 'port');
    ncr_emit("» Checking nginx installation...\n");
    if (!is_file('/usr/sbin/nginx')) {
        ncr_emit("» Installing nginx...\n");
        ncr_run(['apt-get', 'update', '-qq'], null, true, $env);
        ncr_run(['apt-get', 'install', '-y', 'nginx'], null, true, $env);
        if (!is_file('/usr/sbin/nginx')) { ncr_emit("ERROR: nginx install failed. Aborting.\n"); return 1; }
    }
    ncr_emit("» Stopping nginx to avoid config conflicts...\n");
    ncr_run(['systemctl', 'stop', 'nginx']);
    ncr_emit("» Migrating Apache from port 80 → {$port}...\n");
    $moved = function (int $from, int $to): void {
        ob_start(); cmd_web_apache_port(['from' => $from, 'to' => $to]); ob_end_clean();
    };
    $moved(80, $port);
    [, $test] = ncr_run(['apache2ctl', 'configtest']);
    if (!str_contains($test, 'Syntax OK')) {
        ncr_emit("ERROR: Apache config test failed:\n{$test}\nRolling back...\n");
        $moved($port, 80);
        ncr_run(['systemctl', 'restart', 'apache2']);
        ncr_emit("  Apache restored to port 80. Aborting.\n");
        return 1;
    }
    ncr_run(['systemctl', 'restart', 'apache2']);
    ncr_emit("  Apache is up on port {$port}\n");
    ncr_emit("» Configuring nginx (remove default site, add catch-all)...\n");
    @unlink('/etc/nginx/sites-enabled/default');
    ncr_write_file('/etc/nginx/sites-available/novacpx-default.conf', "server {\n    listen 80 default_server;\n    server_name _;\n    return 444;\n}\n");
    if (!file_exists('/etc/nginx/sites-enabled/novacpx-default.conf')) symlink('/etc/nginx/sites-available/novacpx-default.conf', '/etc/nginx/sites-enabled/novacpx-default.conf');
    if (!file_exists('/etc/nginx/conf.d/novacpx-proxy.conf')) ncr_write_file('/etc/nginx/conf.d/novacpx-proxy.conf', "client_max_body_size 256M;\nproxy_buffers 16 16k;\nproxy_buffer_size 16k;\n");
    ncr_emit("» Starting nginx on port 80/443...\n");
    ncr_run(['systemctl', 'enable', 'nginx']); ncr_run(['systemctl', 'start', 'nginx']);
    sleep(1);
    [, $act] = ncr_run(['systemctl', 'is-active', 'nginx']);
    if (trim($act) !== 'active') {
        [, $err] = ncr_run(['nginx', '-t']);
        ncr_emit("ERROR: nginx failed to start:\n{$err}\nApache is running on port {$port}. Fix nginx config and try again.\n");
        return 1;
    }
    ncr_emit("  nginx is running\n");
    return 0;
}

// ───────────────────────── Site Shield (per-account nginx rules) ─────────────────────────
//
// Writes /etc/nginx/novacpx-custom/<user>/10-shield.conf (+ shield-htpasswd-N files) from validated parameters only; the vhost
// pulls the directory in with an include, so regenerating the vhost never drops these rules. A change that nginx rejects is
// rolled back and the nginx error is returned.

const NCR_CUSTOM_DIR = '/etc/nginx/novacpx-custom';
const NCR_SHIELD_CODES = [400, 401, 403, 404, 500, 502, 503];
const NCR_SHIELD_EXT = 'jpg|jpeg|png|gif|webp|svg|bmp|ico|avif|mp4|webm|mp3|ogg|pdf|zip';

/** An IPv4/IPv6 address or CIDR range. */
function v_cidr(mixed $v): string {
    if (!is_string($v) || strlen($v) > 50) refuse('invalid address or range');
    $parts = explode('/', $v);
    if (count($parts) > 2 || !filter_var($parts[0], FILTER_VALIDATE_IP)) refuse('invalid address or range');
    if (count($parts) === 2) {
        $max = str_contains($parts[0], ':') ? 128 : 32;
        if (!ctype_digit($parts[1]) || (int)$parts[1] > $max) refuse('invalid address or range');
    }
    return $v;
}

/** A URL path made only of safe segments (no dots-only segments, no query, no quotes). */
function v_url_path(mixed $v): string {
    if (!is_string($v) || strlen($v) > 200 || !preg_match('#^/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*/?$#', $v)) refuse('invalid path');
    foreach (explode('/', trim($v, '/')) as $seg) if ($seg === '.' || $seg === '..') refuse('invalid path');
    return $v;
}

/** Make sure the account's vhost loads the custom directory (older vhosts were generated without the include). */
function ncr_vhost_custom_include(string $user): void {
    $f = "/etc/nginx/sites-available/novacpx-{$user}.conf";
    if (!is_file($f) || is_link($f)) refuse('no vhost for this account');
    $s = (string)file_get_contents($f);
    if (str_contains($s, NCR_CUSTOM_DIR . "/{$user}/")) return;
    if (!preg_match('/fastcgi_pass (unix:[^;]+);/', $s, $m)) refuse('cannot find the PHP socket in the vhost');
    $new = preg_replace('/^([ \t]*error_log[^\n]*\n)/m',
        "$1\n    set \$novacpx_php_sock {$m[1]};\n    include " . NCR_CUSTOM_DIR . "/{$user}/*.conf;\n", $s, 1, $n);
    if (!$n) refuse('cannot patch the vhost');
    ncr_write_file($f, $new);
}

function cmd_site_rules_write(array $p): int {
    $pw   = v_managed_user($p['username'] ?? null);
    $user = $pw['name'];
    if (ncr_webserver() !== 'nginx') refuse('Site Shield needs the nginx web server');

    // ── validate everything ──
    $ips = [];
    foreach ((array)($p['blocked_ips'] ?? []) as $ip) $ips[] = v_cidr($ip);
    if (count($ips) > 200) refuse('too many blocked addresses (max 200)');
    $ips = array_values(array_unique($ips));

    $hot = (array)($p['hotlink'] ?? []);
    $hotOn = !empty($hot['enabled']);
    $hotAllowed = [];
    foreach ((array)($hot['allowed'] ?? []) as $d) $hotAllowed[] = v_domain($d);
    if (count($hotAllowed) > 50) refuse('too many allowed referrer domains (max 50)');

    $folders = (array)($p['folders'] ?? []);
    if (count($folders) > 20) refuse('too many locked folders (max 20)');
    $folderOut = [];
    $seenPaths = [];
    foreach ($folders as $f) {
        $path  = rtrim(v_url_path($f['path'] ?? null), '/');
        if (isset($seenPaths[$path])) refuse('the same folder is listed twice');
        $seenPaths[$path] = true;
        $realm = (string)($f['realm'] ?? 'Restricted');
        if (!preg_match('/^[A-Za-z0-9 ._-]{1,40}$/', $realm)) refuse('invalid realm text');
        $users = (array)($f['users'] ?? []);
        if (!$users) refuse("folder {$path} needs at least one user");
        if (count($users) > 50) refuse('too many users on one folder (max 50)');
        $lines = []; $names = [];
        foreach ($users as $u) {
            $n = (string)($u['name'] ?? ''); $h = (string)($u['hash'] ?? '');
            if (!preg_match('/^[A-Za-z0-9._-]{1,32}$/', $n)) refuse('invalid folder user name');
            if (!preg_match('/^\$2[aby]\$[0-9]{2}\$[.\/A-Za-z0-9]{53}$/', $h)) refuse('invalid password hash');
            if (isset($names[$n])) refuse('duplicate folder user name');
            $names[$n] = true;
            $lines[] = "{$n}:{$h}";
        }
        $folderOut[] = ['path' => $path, 'realm' => $realm, 'ht' => implode("\n", $lines) . "\n"];
    }

    $errors = [];
    foreach ((array)($p['error_pages'] ?? []) as $code => $page) {
        if ($page === '' || $page === null) continue;
        $c = (int)$code;
        if (!in_array($c, NCR_SHIELD_CODES, true)) refuse('unsupported error code');
        $errors[$c] = v_url_path($page);
    }

    // ── render ──
    $conf = "# NovaCPX Site Shield for {$user} - generated by the panel, edit it in the panel instead\n";
    foreach ($ips as $ip) $conf .= "deny {$ip};\n";
    foreach ($errors as $c => $page) $conf .= "error_page {$c} {$page};\n";
    if ($hotOn) {
        $refs = ['none', 'blocked', 'server_names'];
        foreach ($hotAllowed as $d) { $refs[] = $d; $refs[] = "*.{$d}"; }
        $conf .= "location ~* \\.(" . NCR_SHIELD_EXT . ")\$ {\n    valid_referers " . implode(' ', $refs) . ";\n"
              .  "    if (\$invalid_referer) { return 403; }\n    expires 30d;\n    add_header Cache-Control public;\n}\n";
    }
    $htFiles = [];
    foreach ($folderOut as $i => $f) {
        $htName = "shield-htpasswd-{$i}";
        $htFiles[$htName] = $f['ht'];
        $conf .= "location = {$f['path']} { return 301 {$f['path']}/; }\n"
              .  "location ^~ {$f['path']}/ {\n    auth_basic \"{$f['realm']}\";\n    auth_basic_user_file " . NCR_CUSTOM_DIR . "/{$user}/{$htName};\n"
              .  "    index index.php index.html index.htm;\n    try_files \$uri \$uri/ =404;\n"
              .  "    location ~ \\.php\$ {\n        fastcgi_pass \$novacpx_php_sock;\n        include fastcgi_params;\n"
              .  "        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;\n    }\n}\n";
    }

    // ── apply, with rollback ──
    $dir = NCR_CUSTOM_DIR . "/{$user}";
    if (!is_dir($dir) && !mkdir($dir, 0755, true)) refuse('cannot create the rules directory');
    $old = [];
    foreach (array_merge(glob("{$dir}/10-shield.conf") ?: [], glob("{$dir}/shield-htpasswd-*") ?: []) as $f) {
        $old[$f] = (string)file_get_contents($f);
        unlink($f);
    }
    $restore = function () use ($dir, $old, $htFiles) {
        foreach (array_merge(glob("{$dir}/10-shield.conf") ?: [], glob("{$dir}/shield-htpasswd-*") ?: []) as $f) @unlink($f);
        foreach ($old as $f => $c) ncr_write_file($f, $c, str_contains($f, 'htpasswd') ? 0640 : 0644, 'root', str_contains($f, 'htpasswd') ? 'www-data' : 'root');
    };
    $hasRules = $ips || $errors || $hotOn || $folderOut;
    if ($hasRules) {
        foreach ($htFiles as $name => $content) ncr_write_file("{$dir}/{$name}", $content, 0640, 'root', 'www-data');
        ncr_write_file("{$dir}/10-shield.conf", $conf);
        try { ncr_vhost_custom_include($user); } catch (NcrRefused $e) { $restore(); throw $e; }
    }
    [$rc, $out] = ncr_run(['nginx', '-t']);
    if ($rc !== 0) {
        $restore();
        echo "nginx rejected the rules, nothing was changed:\n" . $out;
        return 1;
    }
    [$rc, $out] = ncr_run(['systemctl', 'reload', 'nginx']);
    echo $out;
    return $rc;
}

// ───────────────────────── WAF ─────────────────────────

/** Request-filter rules the panel can switch on per account. Each is an nginx condition; the patterns are fixed here, never user text. */
const NCR_WAF_RULES = [
    'sqli'      => ['$request_uri', '~*', "(union(%20|\+| )+(all(%20|\+| )+)?select|information_schema|sleep\((%20)?[0-9]+\)|benchmark\(|(%27|')(%20|\+| )*(or|and)(%20|\+| )+[0-9a-z]+(%20|\+| )*=)"],
    'xss'       => ['$request_uri', '~*', "((%3c|<)(%20)*(script|iframe|object|embed|svg)|javascript:|onerror(%20)*=|onload(%20)*=)"],
    'traversal' => ['$request_uri', '~*', "(\.\./|\.\.%2f|%2e%2e(/|%2f|%5c)|/etc/passwd|/proc/self|boot\.ini)"],
    'inclusion' => ['$request_uri', '~*', "(php://|data://|expect://|zip://|phar://|allow_url_include|auto_prepend_file|base64_decode\(|eval\()"],
    'scanners'  => ['$http_user_agent', '~*', "(sqlmap|nikto|acunetix|nessus|masscan|wpscan|havij|dirbuster|zgrab|nuclei|nmap scripting)"],
    'sensitive' => ['$uri', '~*', "(/\.(git|svn|hg|env|ht)|\.(bak|old|orig|swp|sql|dump)\$|/composer\.(json|lock)\$|/\.DS_Store\$)"],
    'methods'   => ['$request_method', '~*', "^(TRACE|TRACK|DEBUG)\$"],
    'xmlrpc'    => ['$uri', '~*', "^/xmlrpc\.php\$"],
];

function cmd_waf_write(array $p): int {
    $pw   = v_managed_user($p['username'] ?? null);
    $user = $pw['name'];
    if (ncr_webserver() !== 'nginx') refuse('the firewall rules need the nginx web server');
    $mode = (string)($p['mode'] ?? 'off');
    if (!in_array($mode, ['off', 'block'], true)) refuse('invalid mode');
    $rules = [];
    foreach ((array)($p['rules'] ?? []) as $r) {
        if (!is_string($r) || !isset(NCR_WAF_RULES[$r])) refuse('unknown firewall rule');
        $rules[$r] = true;
    }
    $exempt = [];
    foreach ((array)($p['exempt'] ?? []) as $path) $exempt[] = rtrim(v_url_path($path), '/');
    if (count($exempt) > 30) refuse('too many exempt paths (max 30)');
    $exempt = array_values(array_unique($exempt));

    $conf = "# NovaCPX firewall for {$user} - generated by the panel, edit it in the panel instead\n";
    if ($mode === 'block' && $rules) {
        $conf .= "set \$novacpx_waf 0;\n";
        foreach (array_keys($rules) as $r) {
            [$var, $op, $re] = NCR_WAF_RULES[$r];
            $conf .= "if ({$var} {$op} \"{$re}\") { set \$novacpx_waf 1; }\n";
        }
        foreach ($exempt as $path) $conf .= "if ($request_uri ~ \"^" . preg_quote($path, '~') . "(/|\?|$)\") { set \$novacpx_waf 0; }\n";
        $conf .= "if (\$novacpx_waf) { return 403; }\n";
    }

    $dir = NCR_CUSTOM_DIR . "/{$user}";
    if (!is_dir($dir) && !mkdir($dir, 0755, true)) refuse('cannot create the rules directory');
    $file = "{$dir}/20-waf.conf";
    $old = is_file($file) ? (string)file_get_contents($file) : null;
    $restore = function () use ($file, $old) { if ($old === null) @unlink($file); else ncr_write_file($file, $old); };
    if ($mode === 'block' && $rules) {
        ncr_write_file($file, $conf);
        try { ncr_vhost_custom_include($user); } catch (NcrRefused $e) { $restore(); throw $e; }
    } else {
        @unlink($file);
    }
    [$rc, $out] = ncr_run(['nginx', '-t']);
    if ($rc !== 0) { $restore(); echo "nginx rejected the rules, nothing was changed:\n" . $out; return 1; }
    [$rc, $out] = ncr_run(['systemctl', 'reload', 'nginx']);
    echo $out;
    return $rc;
}

// ───────────────────────── Mail queue ─────────────────────────

function v_queue_id(mixed $v): string {
    if (!is_string($v) || !preg_match('/^[0-9A-Za-z]{6,25}$/', $v)) refuse('invalid queue id');
    return $v;
}

/** The Postfix queue as JSON (at most 500 messages). */
function cmd_mail_queue_list(array $p): int {
    [$rc, $out] = ncr_run(['postqueue', '-j']);
    if ($rc !== 0) { echo $out; return $rc; }
    $items = [];
    foreach (explode("\n", trim($out)) as $line) {
        if ($line === '') continue;
        $j = json_decode($line, true);
        if (!is_array($j)) continue;
        $items[] = [
            'id' => (string)($j['queue_id'] ?? ''), 'queue' => (string)($j['queue_name'] ?? ''), 'time' => (int)($j['arrival_time'] ?? 0),
            'size' => (int)($j['message_size'] ?? 0), 'sender' => (string)($j['sender'] ?? ''),
            'recipients' => array_map(fn($r) => ['address' => (string)($r['address'] ?? ''), 'reason' => (string)($r['delay_reason'] ?? '')], (array)($j['recipients'] ?? [])),
        ];
        if (count($items) >= 500) break;
    }
    return ncr_json($items);
}

/** flush (retry everything) | retry | delete | hold | release one message, or purge the whole queue (needs confirm_all). */
function cmd_mail_queue_action(array $p): int {
    $act = $p['action'] ?? '';
    switch ($act) {
        case 'flush':   return ncr_out(ncr_run(['postqueue', '-f']), false);
        case 'retry':   return ncr_out(ncr_run(['postqueue', '-i', v_queue_id($p['id'] ?? null)]), false);
        case 'delete':  return ncr_out(ncr_run(['postsuper', '-d', v_queue_id($p['id'] ?? null)]), false);
        case 'hold':    return ncr_out(ncr_run(['postsuper', '-h', v_queue_id($p['id'] ?? null)]), false);
        case 'release': return ncr_out(ncr_run(['postsuper', '-H', v_queue_id($p['id'] ?? null)]), false);
        case 'purge':
            if (empty($p['confirm_all'])) refuse('purge needs confirm_all');
            return ncr_out(ncr_run(['postsuper', '-d', 'ALL']), false);
    }
    refuse('unknown queue action');
}

// ───────────────────────── Sweep: quarantine ─────────────────────────

/** An existing regular file below the account's home (never a symlink, never inside the quarantine). Returns [absolute path, relative path]. */
function v_account_file(string $user, mixed $rel): array {
    if (!is_string($rel) || $rel === '' || strlen($rel) > 400 || str_contains($rel, "\0") || str_contains($rel, '..')) refuse('invalid path');
    $rel = ltrim($rel, '/');
    if ($rel === '' || str_starts_with($rel, '.quarantine/')) refuse('invalid path');
    $abs = "/home/{$user}/{$rel}";
    if (is_link($abs) || !is_file($abs)) refuse('not a regular file');
    $real = realpath($abs);
    if ($real === false || !str_starts_with($real, "/home/{$user}/") || str_starts_with($real, "/home/{$user}/.quarantine/")) refuse('outside the account');
    return [$real, substr($real, strlen("/home/{$user}/"))];
}

function ncr_quarantine_name(int $id, string $rel): string {
    return "f{$id}__" . substr(preg_replace('/[^A-Za-z0-9._-]/', '_', basename($rel)), 0, 80);
}

function cmd_sweep_quarantine(array $p): int {
    $user = v_managed_user($p['username'] ?? null)['name'];
    $id   = v_int($p['id'] ?? null, 1, PHP_INT_MAX, 'finding id');
    [$abs, $rel] = v_account_file($user, $p['path'] ?? null);
    $dir = "/home/{$user}/.quarantine";
    if (is_link($dir)) refuse('quarantine is a symlink');
    if (!is_dir($dir) && !mkdir($dir, 0700)) refuse('cannot create the quarantine folder');
    chown($dir, 'root'); chgrp($dir, 'root'); chmod($dir, 0700);
    $dest = "{$dir}/" . ncr_quarantine_name($id, $rel);
    if (file_exists($dest)) refuse('already quarantined');
    if (!rename($abs, $dest)) refuse('move failed');
    chown($dest, 'root'); chgrp($dest, 'root'); chmod($dest, 0000);
    return ncr_json(['quarantined' => $rel]);
}

function cmd_sweep_restore(array $p): int {
    $user = v_managed_user($p['username'] ?? null)['name'];
    $id   = v_int($p['id'] ?? null, 1, PHP_INT_MAX, 'finding id');
    $rel  = $p['path'] ?? null;
    if (!is_string($rel) || $rel === '' || strlen($rel) > 400 || str_contains($rel, '..') || str_contains($rel, "\0")) refuse('invalid path');
    $rel  = ltrim($rel, '/');
    $src  = "/home/{$user}/.quarantine/" . ncr_quarantine_name($id, $rel);
    $dest = "/home/{$user}/{$rel}";
    if (!is_file($src)) refuse('nothing in quarantine for this finding');
    if (file_exists($dest) || is_link($dest)) refuse('a file already exists at the original location');
    $parent = dirname($dest);
    if (!is_dir($parent) || is_link($parent) || !str_starts_with((string)realpath($parent), "/home/{$user}")) refuse('the original folder no longer exists');
    $pw = posix_getpwnam($user);
    if (!rename($src, $dest)) refuse('move failed');
    chown($dest, $user); chgrp($dest, 'www-data'); chmod($dest, 0640);
    return ncr_json(['restored' => $rel]);
}

// ───────────────────────── Git Deploy ─────────────────────────

const NCR_GIT_TOKEN_DIR = '/etc/novacpx/git-tokens';

function v_git_url(mixed $v): string {
    if (!is_string($v) || strlen($v) > 300 || !preg_match('#^https://([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,63}(:[0-9]{2,5})?/[A-Za-z0-9._~/-]+$#', $v)) refuse('repository address must be an https:// URL');
    $host = parse_url($v, PHP_URL_HOST);
    $ip = gethostbyname((string)$host);
    // never let a customer point the server at its own network
    if (!filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE)) refuse('repository host is not publicly reachable');
    return $v;
}

function v_git_branch(mixed $v): string {
    if (!is_string($v) || !preg_match('#^[A-Za-z0-9._/-]{1,100}$#', $v) || str_contains($v, '..') || str_starts_with($v, '-') || str_starts_with($v, '/')) refuse('invalid branch name');
    return $v;
}

function v_git_subdir(mixed $v): string {
    $v = trim((string)($v ?? ''), '/');
    if ($v === '') return '';
    if (strlen($v) > 120 || !preg_match('#^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$#', $v) || str_contains($v, '..')) refuse('invalid folder');
    return $v;
}

function cmd_git_deploy(array $p): int {
    $pw     = v_managed_user($p['username'] ?? null);
    $user   = $pw['name'];
    $url    = v_git_url($p['repo_url'] ?? null);
    $branch = v_git_branch($p['branch'] ?? 'main');
    $sub    = v_git_subdir($p['subdir'] ?? '');
    $over   = !empty($p['overwrite']);

    // access token: kept root-only, never in the panel database or in any output
    if (!is_dir(NCR_GIT_TOKEN_DIR)) mkdir(NCR_GIT_TOKEN_DIR, 0700, true);
    $tokFile = NCR_GIT_TOKEN_DIR . "/{$user}";
    if (!empty($p['clear_token'])) @unlink($tokFile);
    if (isset($p['token']) && is_string($p['token']) && $p['token'] !== '') {
        if (!preg_match('/^[A-Za-z0-9._~+=\/-]{8,200}$/', $p['token'])) refuse('invalid access token');
        ncr_write_file($tokFile, $p['token'], 0600);
    }
    $token = is_file($tokFile) ? trim((string)file_get_contents($tokFile)) : '';

    $root = "/home/{$user}/public_html";
    $dir  = $sub === '' ? $root : "{$root}/{$sub}";
    if (is_link($root) || !is_dir($root)) refuse('the account has no public_html folder');
    if (!is_dir($dir)) {
        [$rc, $o] = ncr_run(['runuser', '-u', $user, '--', 'mkdir', '-p', $dir]);
        if ($rc !== 0) refuse('cannot create the folder');
    }
    $real = realpath($dir);
    if ($real === false || ($real !== $root && !str_starts_with($real, $root . '/'))) refuse('folder is outside public_html');

    $git = ['runuser', '-u', $user, '--', 'timeout', '180', 'git',
            '-c', 'core.hooksPath=/dev/null', '-c', 'protocol.allow=never', '-c', 'protocol.https.allow=always', '-c', 'safe.directory=' . $real];
    if ($token !== '') $git = array_merge($git, ['-c', 'http.extraHeader=Authorization: Basic ' . base64_encode('git:' . $token)]);
    $env = ['HOME' => "/home/{$user}", 'GIT_TERMINAL_PROMPT' => '0', 'GIT_CONFIG_NOSYSTEM' => '1'];
    $log = '';
    $run = function (array $args) use ($git, $env, $real, &$log, $token) {
        [$rc, $out] = ncr_run(array_merge($git, ['-C', $real], $args), null, false, $env);
        if ($token !== '') $out = str_replace([$token, base64_encode('git:' . $token)], '***', $out);
        $log .= $out;
        return $rc;
    };

    $isRepo = is_dir("{$real}/.git");
    if (!$isRepo) {
        $entries = array_diff(scandir($real) ?: [], ['.', '..']);
        if ($entries && !$over) refuse('The folder already has files. Tick "replace existing files" to connect the repository anyway (tracked files are overwritten, other files stay).');
        if ($run(['init', '-q']) !== 0) { echo $log; return 1; }
        $run(['remote', 'add', 'origin', $url]);
    } else {
        $run(['remote', 'set-url', 'origin', $url]);
    }
    if ($run(['fetch', '--prune', '--depth', '50', 'origin', $branch]) !== 0) {
        echo json_encode(['ok' => false, 'output' => substr($log, -3000)]) . "\n"; return 1;
    }
    if ($run(['checkout', '-q', '-f', '-B', $branch, 'FETCH_HEAD']) !== 0) {
        echo json_encode(['ok' => false, 'output' => substr($log, -3000)]) . "\n"; return 1;
    }
    $run(['reset', '-q', '--hard', 'FETCH_HEAD']);
    [, $commit] = ncr_run(array_merge($git, ['-C', $real, 'log', '-1', '--pretty=%h %s']), null, false, $env);
    ncr_run(['chown', '-R', "{$user}:www-data", $real]);
    return ncr_json(['ok' => true, 'commit' => trim($commit), 'output' => substr($log, -3000), 'has_token' => $token !== '']);
}

/** Remove the stored access token of an account (when the repository is disconnected). */
function cmd_git_forget(array $p): int {
    $user = v_username($p['username'] ?? null);
    @unlink(NCR_GIT_TOKEN_DIR . "/{$user}");
    return 0;
}

